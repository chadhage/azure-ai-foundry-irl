# Reference only: the application does not automatically load .env files.
# Set these variables in the shell or your eventual hosting configuration.
PORT=8000

# Origins only: no wildcard, credentials, trailing slash, or project URL path.
CORS_ALLOWED_ORIGINS=https://chadhage.github.io
# Local metadata API access, only if needed:
# CORS_ALLOWED_ORIGINS=https://chadhage.github.io,http://localhost:8080,http://127.0.0.1:8080

# Optional. Relative paths resolve from the repository root.
# The default is data/catalog.json. Use synthetic, publishable metadata only.
# CATALOG_PATH=data/catalog.json
